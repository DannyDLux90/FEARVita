+void PumpAvAudio(BinkVideoHandle* video) {
+  if (!video || !HasAvPlayer(video) || !(video->options & eVTO_PlaySound)) return;
+  SceAvPlayerFrameInfo audio{};
+  if (sceAvPlayerGetAudioData(video->av_player, &audio) != SCE_TRUE || !audio.pData) return;
+  const uint16_t channels = audio.details.audio.channelCount;
+  const uint32_t rate = audio.details.audio.sampleRate;
+  if ((channels != 1 && channels != 2) || !rate || audio.details.audio.size < channels * 2u) return;
+  uint32_t samples = audio.details.audio.size / (channels * 2u);
+  samples = (samples / 64u) * 64u;
+  if (samples < SCE_AUDIO_MIN_LEN) return;
+  if (video->av_audio_port < 0 || video->av_audio_samples != samples ||
+      video->av_audio_rate != rate || video->av_audio_channels != channels) {
+    if (video->av_audio_port >= 0) sceAudioOutReleasePort(video->av_audio_port);
+    video->av_audio_port = sceAudioOutOpenPort(SCE_AUDIO_OUT_PORT_TYPE_BGM,
+        static_cast<int>(samples), static_cast<int>(rate),
+        channels == 2 ? SCE_AUDIO_OUT_MODE_STEREO : SCE_AUDIO_OUT_MODE_MONO);
+    if (video->av_audio_port < 0) {
+      fearvita::RuntimeDiagnostic("bink-audio", "sceAudioOutOpenPort failed result=" +
+          std::to_string(video->av_audio_port));
+      return;
+    }
+    video->av_audio_samples = samples;
+    video->av_audio_rate = rate;
+    video->av_audio_channels = channels;
+  }
+  if (!video->av_audio_logged) {
+    video->av_audio_logged = true;
+    fearvita::RuntimeDiagnostic("bink-audio", "first-frame rate=" + std::to_string(rate) +
+        " channels=" + std::to_string(channels) + " samples=" + std::to_string(samples));
+  }
+  sceAudioOutOutput(video->av_audio_port, audio.pData);
+}
