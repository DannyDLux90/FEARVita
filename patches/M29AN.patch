+#if defined(FEARVITA_PORTABLE_COMPILE) || defined(PLATFORM_VITA) || defined(__vita__)
+		// M29AN: The Vita frontend currently has no ILTCommon implementation
+		// (ILTClient::Common() intentionally returns NULL).  Expansion-only
+		// weapons introduce dynamic animation properties such as NailGun, Cannon
+		// and Plasma during CClientWeaponMgr::Init.  The original code tries to
