+bool CScreenWeapons::OnLeft()
+{
+	if (m_pSelectedWpn)
+	{
+		uint32 nIndex = m_pWeapons->GetIndex(m_pSelectedWpn);
+		if (nIndex != CLTGUIListCtrl::kNoSelection && nIndex > 0)
+		{
+			OnCommand(CMD_UP, 0, 0);
+			m_pWeapons->SetSelection(nIndex - 1);
+			SelectWeapon(m_pSelectedWpn);
+			g_pInterfaceMgr->RequestInterfaceSound(IS_CHANGE);
+#if defined(PLATFORM_VITA) || defined(FEARVITA_PORTABLE_COMPILE)
+			fearvita::RuntimeDiagnostic("weapon-audit", std::string("reorder dir=up index=") + std::to_string(nIndex) +
+				" new-index=" + std::to_string(nIndex - 1));
+#endif
+			return true;
+		}
+	}
+	return CBaseScreen::OnLeft();
+}
+
+bool CScreenWeapons::OnRight()
+{
+	if (m_pSelectedWpn)
+	{
+		uint32 nIndex = m_pWeapons->GetIndex(m_pSelectedWpn);
+		if (nIndex != CLTGUIListCtrl::kNoSelection && nIndex + 1 < m_pWeapons->GetNumControls())
+		{
+			OnCommand(CMD_DOWN, 0, 0);
+			m_pWeapons->SetSelection(nIndex + 1);
+			SelectWeapon(m_pSelectedWpn);
+			g_pInterfaceMgr->RequestInterfaceSound(IS_CHANGE);
+#if defined(PLATFORM_VITA) || defined(FEARVITA_PORTABLE_COMPILE)
+			fearvita::RuntimeDiagnostic("weapon-audit", std::string("reorder dir=down index=") + std::to_string(nIndex) +
+				" new-index=" + std::to_string(nIndex + 1));
+#endif
+			return true;
+		}
+	}
+	return CBaseScreen::OnRight();
+}
