@@ -0,0 +1,41 @@
+#pragma once
+#include <psp2/types.h>
+
+enum SceTouchPortType {
+  SCE_TOUCH_PORT_FRONT = 0,
+  SCE_TOUCH_PORT_BACK = 1,
+};
+enum SceTouchSamplingState {
+  SCE_TOUCH_SAMPLING_STATE_STOP = 0,
+  SCE_TOUCH_SAMPLING_STATE_START = 1,
+};
+struct SceTouchPanelInfo {
+  SceInt16 minAaX = 0, minAaY = 0, maxAaX = 1919, maxAaY = 1087;
+  SceInt16 minDispX = 0, minDispY = 0, maxDispX = 959, maxDispY = 543;
+  SceUInt8 minForce = 0, maxForce = 255, reserved[30]{};
+};
+struct SceTouchReport {
+  SceUInt8 id = 0, force = 0;
+  SceInt16 x = 0, y = 0;
+  SceUInt8 reserved[8]{};
+  SceUInt16 info = 0;
+};
+struct SceTouchData {
+  SceUInt64 timeStamp = 0;
+  SceUInt32 status = 0;
+  SceUInt32 reportNum = 0;
+  SceTouchReport report[8]{};
+};
+inline SceTouchData& mock_touch_front_sample() { static SceTouchData v{}; return v; }
+inline SceTouchData& mock_touch_back_sample() { static SceTouchData v{}; return v; }
+inline int sceTouchSetSamplingState(SceUInt32, SceTouchSamplingState) { return 0; }
+inline int sceTouchGetPanelInfo(SceUInt32, SceTouchPanelInfo* out) {
+  if (!out) return -1;
+  *out = SceTouchPanelInfo{};
+  return 0;
+}
+inline int sceTouchPeek(SceUInt32 port, SceTouchData* out, SceUInt32 count) {
+  if (!out || count == 0) return -1;
+  *out = (port == SCE_TOUCH_PORT_BACK) ? mock_touch_back_sample() : mock_touch_front_sample();
+  return 1;
+}
