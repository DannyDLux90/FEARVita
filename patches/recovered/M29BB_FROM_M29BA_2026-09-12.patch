 void LTObjRef::Link(HOBJECT hObj)
 {
+#if defined(PLATFORM_VITA) || defined(FEARVITA_PORTABLE_COMPILE)
+	// FEARVita links the client shell and local server into one executable, so
+	// both ILTClient and ILTServer holders can be populated at the same time.
+	// The original module-separated code preferred ILTServer whenever present,
+	// which is unsafe here: frontend objects created by the Vita ILTClient are
+	// opaque VitaLocalObject handles, not runtime LTObject instances.  First let
+	// the client interface claim client-owned handles; only fall back to the
+	// server interface when the client reports that the handle is not one of its
+	// objects.  This preserves real server LTObject reference-list tracking while
+	// preventing client-local cameras/effects from being reinterpreted as
+	// LTObject and passed to CLTServer::LinkObjRef.
+	if (hObj)
+	{
+		if (g_pLTObjRef_InterfaceC &&
+			((ILTCSBase *)g_pLTObjRef_InterfaceC)->LinkObjRef(hObj, this) == LT_OK)
+		{
+			SetData(hObj);
+			return;
+		}
+
+		if (g_pLTObjRef_InterfaceS &&
+			((ILTCSBase *)g_pLTObjRef_InterfaceS)->LinkObjRef(hObj, this) == LT_OK)
+		{
+			SetData(hObj);
+			return;
+		}
+
+		SetData(NULL);
+		return;
+	}
+
+	SetData(NULL);
+#else
 	ILTCSBase *pInterface = g_pLTObjRef_InterfaceS ? (ILTCSBase *)g_pLTObjRef_InterfaceS : (ILTCSBase *)g_pLTObjRef_InterfaceC;
 	if (!pInterface)
 	{
@@ -37,6 +70,7 @@
 	}
 
 	SetData(hObj);
+#endif
 }
 
