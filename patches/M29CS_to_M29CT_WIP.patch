--- a/m29ay_src/project/integration/lithtech/fearvita_lithtech_input_bridge.cpp
+++ b/m29ay_src/project/integration/lithtech/fearvita_lithtech_input_bridge.cpp
@@
 extern "C" bool FearVita_IsCommandOn(int command_id) {
   return g_input_runtime.IsCommandOn(command_id);
 }
+
+extern "C" float FearVita_GetCommandAxisValue(int command_id) {
+  auto* controller = fearvita::GetActiveControllerInput();
+  if (!controller) return 0.0f;
+  const auto& st = controller->state();
+  switch (command_id) {
+    case fearvita::FearCommand_ForwardAxis: return st.move_y;
+    case fearvita::FearCommand_StrafeAxis: return st.move_x;
+    case fearvita::FearCommand_Yaw: return st.look_x;
+    case fearvita::FearCommand_Pitch: return st.look_y;
+    default: return 0.0f;
+  }
+}
