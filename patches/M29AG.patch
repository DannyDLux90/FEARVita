+bool IsMenuMusic(const char* name) {
+  std::string value = name ? name : "";
+  std::replace(value.begin(), value.end(), '/', '\\');
+  std::transform(value.begin(), value.end(), value.begin(),
+      [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return value == "music\\introintlp1v2.wav" ||
+      (value.size() >= 17 && value.rfind("introintlp1v2.wav") == value.size() - 17);
+}
+
+void ExportMenuMusicOnce(const char* name, const std::vector<std::uint8_t>& file) {
+  static bool attempted = false;
+  if (attempted || !IsMenuMusic(name) || file.empty()) return;
+  attempted = true;
+  sceIoMkdir("ux0:data", 0777);
+  sceIoMkdir("ux0:data/FEARVita", 0777);
+  sceIoMkdir("ux0:data/FEARVita/debug", 0777);
+  const char* path = "ux0:data/FEARVita/debug/IntroIntLp1v2.wav";
+  const SceUID fd = sceIoOpen(path, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0666);
+  if (fd < 0) {
+    fearvita::RuntimeDiagnostic("sound-export", std::string("open-failed result=") + std::to_string(fd));
+    return;
+  }
+  std::size_t written = 0;
+  while (written < file.size()) {
+    const int n = sceIoWrite(fd, file.data() + written,
+        static_cast<SceSize>(std::min<std::size_t>(file.size() - written, 1024u * 1024u)));
+    if (n <= 0) break;
+    written += static_cast<std::size_t>(n);
+  }
+  sceIoClose(fd);
+  fearvita::RuntimeDiagnostic("sound-export", std::string("menu-wav path=") + path +
+      " bytes=" + std::to_string(written) + " expected=" + std::to_string(file.size()) +
+      " complete=" + (written == file.size() ? "1" : "0"));
+}
