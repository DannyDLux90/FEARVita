+
+bool FearVita_PlayInterfaceSound(const char* name) {
+  if (!name || !*name) return false;
+
+  PlaySoundInfo psi;
+  PLAYSOUNDINFO_INIT(psi);
+  psi.m_dwFlags = PLAYSOUND_LOCAL;
+  std::strncpy(psi.m_szSoundName, name, _MAX_PATH - 1);
+  psi.m_szSoundName[_MAX_PATH - 1] = '\0';
+  psi.m_nMixChannel = PLAYSOUND_MIX_UI;
+
+  HLTSOUND handle = nullptr;
+  const LTRESULT result = g_sound_mgr.PlaySound(&psi, handle);
+  fearvita::RuntimeDiagnostic("launcher-sound",
+      std::string("name=") + name + " result=" + std::to_string(result));
+  return result == LT_OK;
+}
 LTRESULT FearVita_SoundGetTimer(HLTSOUND hSound, LTFLOAT* seconds) { return g_sound_mgr.GetLogicalTimer(hSound, seconds); }
