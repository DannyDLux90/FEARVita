--- a/FEAR/ClientShellDLL/GameClientShell.cpp
+++ b/FEAR/ClientShellDLL/GameClientShell.cpp
@@ -1539,6 +1539,19 @@
 	g_pClientConnectionMgr->SetModName( RETAIL_MOD_NAME );
 	FEARVITA_INIT_STAGE("frontend-vita-mod-ok");
 
+	// The Vita frontend returns early below, so all runtime systems needed later
+	// by the authentic local single-player handoff must be initialized before
+	// that return.  In particular CSFXMgr owns the dynamic SpecialFX lists.
+	// Leaving it at its constructor defaults makes CSpecialFXList::Add fail for
+	// the real local-player CharacterFX once the stock flow reaches gameplay.
+	FEARVITA_INIT_STAGE("pre-sfx-mgr");
+	if (!m_sfxMgr.Init(g_pLTClient))
+	{
+		g_pLTClient->ShutdownWithMessage(LT_WCHAR_T("Could not initialize SFXMgr!"));
+		return LT_ERROR;
+	}
+	FEARVITA_INIT_STAGE("sfx-mgr-ok");
+
 	m_VersionMgr.Update();
 	FEARVITA_INIT_STAGE("frontend-vita-version-ok");
 
