+// Retail SharedTexture/texture-manager behavior shares file-backed textures.
+// The original Vita shim allocated a fresh decoded RGBA buffer (and therefore a
+// fresh GPU upload cache entry) for every TextureReference::Load call.  FEAR's
+// frontend repeatedly requests the same filenames, which exhausts/fragmentates
+// the Vita heap before ScreenPostload.  Key by normalized VFS path and refcount
+// the existing handle instead.
+std::unordered_map<std::string, FakeTexture*> g_textureByName;
 std::unordered_set<FakeDynamicTexture*> g_dynamicTextures;
+
+std::string NormalizeTextureKey(const char* filename) {
+  std::string key = filename ? filename : "";
+  for (char& c : key) {
+    if (c == '/') c = '\\';
+    if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+  }
+  return key;
+}
+
+std::size_t ActiveTextureRgbaBytes() {
+  std::size_t total = 0;
+  for (const FakeTexture* t : g_textures) {
+    if (t) total += t->rgba.size();
+  }
+  return total;
+}
 
