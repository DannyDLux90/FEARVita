--- a/m29ay_lithtech/lithtech-master/runtime/kernel/src/sys/win/stringmgr.cpp
+++ b/m29ay_lithtech/lithtech-master/runtime/kernel/src/sys/win/stringmgr.cpp
@@ -1,3 +1,17 @@
+
+// FEARVita M29AZ: the global portable MSVC shim maps stricmp to strcasecmp.
+// This TU is also compiled with __LINUX, whose ltbasedefs.h defines an inline
+// stricmp wrapper.  Without undefining the alias here, that wrapper becomes
+// a recursive strcasecmp() definition and overflows the main thread stack
+// during MissionDB case-insensitive lookups.
+#if defined(PLATFORM_VITA)
+#ifdef stricmp
+#undef stricmp
+#endif
+#ifdef strnicmp
+#undef strnicmp
+#endif
+#endif
 
 #include "bdefs.h"
 #include "stringmgr.h"
