+std::string ResolveRetailSplashScreenSound(const CampaignState& campaign) {
+  const FearVfs vfs = BuildFearVfsOverlay(campaign.data_root,
+                                          campaign.root_path,
+                                          campaign.data_root);
+  if (!vfs.ready()) {
+    RuntimeDiagnostic("launcher-splash-sound", "vfs-unavailable");
+    return std::string();
+  }
+
+  static const char* kDatabasePath = "Database/FEAR.Gamdb00p";
+  std::unique_ptr<VfsStream> raw;
+  std::string error;
+  if (!vfs.OpenStream(kDatabasePath, &raw, &error) || !raw) {
+    RuntimeDiagnostic("launcher-splash-sound",
+        std::string("database-open-failed error=") + error);
+    return std::string();
+  }
+
+  IDatabaseMgr* database = GetIDatabaseMgr();
+  if (!database) {
+    RuntimeDiagnostic("launcher-splash-sound", "database-manager-unavailable");
+    return std::string();
+  }
+
+  VfsInStream in(std::move(raw));
+  HDATABASE db = database->OpenNewDatabase(kDatabasePath, in);
+  if (!db) {
+    RuntimeDiagnostic("launcher-splash-sound", "database-parse-failed");
+    return std::string();
+  }
+
+  HATTRIBUTE soundAttribute = database->GetAttribute(
+      db, "Client/Shared", "Shared", "SplashScreenSound");
+  const uint32 soundCount = soundAttribute ? database->GetNumValues(soundAttribute) : 0u;
+  const char* sound = soundCount ? database->GetString(soundAttribute, 0u, "") : "";
+  const std::string resolved = sound ? sound : "";
+  database->ReleaseDatabase(db);
+
+  if (resolved.empty()) {
+    RuntimeDiagnostic("launcher-splash-sound", "Client/Shared.Shared.SplashScreenSound missing");
+    return std::string();
+  }
+
+  RuntimeDiagnostic("launcher-splash-sound",
+      std::string("resolved=") + resolved + " values=" + std::to_string(soundCount));
+  return resolved;
+}
