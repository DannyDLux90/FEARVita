+	static uint8 JexInferPositionBytes(const JexAnimSchema& schema)
+	{
+		// Jupiter EX encodes channel locations as offsets in one of two per-frame
+		// tracks.  The distance from a position channel to the following rotation
+		// channel reveals whether that schema stores position as int16[3] (6 bytes)
+		// or float3 (12 bytes).  This is schema-specific in real F.E.A.R. assets;
+		// the AnimInfo compressed-position word is not reliable as a global selector.
+		uint32 runningOffset = 0;
+		for(size_t i = 0; i < schema.flags.size(); ++i)
+		{
+			const uint16 flag = schema.flags[i];
+			if(flag == 0xFFFF)
+				continue;
+
+			const uint32 offset = static_cast<uint32>(flag & 0x7FFF);
+			if(offset < runningOffset)
+			{
+				// Offsets restart when the flag stream switches to the other track.
+				runningOffset = 0;
+			}
+			const uint32 delta = offset - runningOffset;
+			if(delta == 6 || delta == 12)
+				return static_cast<uint8>(delta);
+			runningOffset = offset;
+		}
+
+		// Schemas with no position samples at all do not consume position data.
+		bool hasPosition = false;
+		for(size_t i = 0; i + 1 < schema.flags.size(); i += 2)
+		{
+			if(schema.flags[i] != 0xFFFF) { hasPosition = true; break; }
+		}
+		if(!hasPosition)
+			return 12;
+
+		// Very small single-channel schemas are seen in tool-generated assets.
+		const uint32 total = static_cast<uint32>(schema.track1Size) + static_cast<uint32>(schema.track2Size);
+		if(total == 6) return 6;
+		return 0;
+	}
