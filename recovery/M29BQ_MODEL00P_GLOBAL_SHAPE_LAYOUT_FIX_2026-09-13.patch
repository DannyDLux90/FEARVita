+	static void JexFindPhysicsShapeLayouts(JexReader& r,
+		uint32 shapeIndex, uint32 shapeCount, uint32 pos, uint32 nodeCount,
+		uint32 expectedConstraintCount, uint32 expectedPhysicsWeightSetCount,
+		std::vector<uint32>& currentExtra,
