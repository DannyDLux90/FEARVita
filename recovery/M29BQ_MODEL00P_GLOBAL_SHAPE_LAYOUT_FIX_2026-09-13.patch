+		const uint32 candidates[2] = { 0u, 24u };
+		for(uint32 c = 0; c < 2; ++c)
+		{
+			const uint32 extra = candidates[c];
+			if(shape.baseEnd > r.len || extra > (r.len - shape.baseEnd))
+				continue;
+			const uint32 nextPos = shape.baseEnd + extra;
+			currentExtra.push_back(extra);
+
+			if(shapeIndex + 1u == shapeCount)
+			{
+				uint32 constraintCount = 0;
+				if(JexPeekU32(r, nextPos, constraintCount) && constraintCount == expectedConstraintCount &&
