+	// Validate enough of the structure immediately after the shape block to
+	// distinguish accidental node-valid parses.  The constraint record sizes
+	// are the v33 sizes documented by the public Model00p research: limited
+	// hinge (type 3) has 18 floats plus three trailing 32-bit values; all
+	// other FEAR v33 constraint records use 24 floats plus one trailing value.
+	// We then require the following physics-weight-set count to match the
+	// model header.  This is validation only; the real parser still consumes
+	// these sections below.
+	static bool JexValidatePhysicsShapeTail(JexReader& r, uint32 pos,
+		uint32 expectedConstraintCount, uint32 expectedPhysicsWeightSetCount)
+	{
+		if(!r.Seek(pos)) return false;
+		uint32 constraintCount = 0;
+		if(!r.Read(constraintCount) || constraintCount != expectedConstraintCount || constraintCount > 65536u)
+			return false;
+
+		for(uint32 i = 0; i < constraintCount; ++i)
+		{
+			uint32 type=0, shapeRef=0, unknown=0;
+			if(!r.Read(type) || !r.Read(shapeRef) || !r.Read(unknown)) return false;
+			const uint32 bytesAfterHeader = (type == 3u) ? (18u * 4u + 3u * 4u) : (24u * 4u + 1u * 4u);
+			if(!r.Skip(bytesAfterHeader)) return false;
+		}
+
+		uint32 weightSetCount = 0;
+		return r.Read(weightSetCount) && weightSetCount == expectedPhysicsWeightSetCount;
